# FairRoom environment variables
# Copy this file to .env and fill in values as needed. Never commit .env.
# Demo mode runs end to end with no keys: npm install && npm run dev

# --- Demo mode ---
DEMO_MODE=true                          # When true, skips iMessage bridge, Photon, and ngrok; seeds fake roommates and sample data

# --- Core server ---
PORT=3000                               # Port the Express/Vite dev server listens on
HOST=127.0.0.1                          # Host interface the server binds to
NODE_ENV=development                    # development | production

# --- Photon 2.0 (live messaging only; leave blank for demo mode) ---
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=
PHOTON_ENABLED=false
PUBLIC_APP_URL=

# --- Optional natural-language intent classification (commands work without it) ---
OPENAI_API_KEY=                         # OpenAI API key for intent classification
OPENAI_MODEL=                           # Available Responses API model supporting strict JSON output

# --- Scheduler and simulator ---
SCOUT_SCHEDULER_ENABLED=false           # Per-group daily catalog checks (does not refresh listing data)
ENABLE_DEVELOPER_SIMULATOR=false        # Enables developer inbound-simulation endpoints

# --- Test recipient (one-message diagnostic only) ---
FAIRROOM_TEST_RECIPIENT=                # Your own number with country code (e.g. +15555550101)

# --- Local iMessage bridge (Mac-only demo transport; not Photon) ---
FAIRROOM_LOCAL_IMESSAGE_ENABLED=false   # Set true only on macOS with Messages access
FAIRROOM_LOCAL_CHAT_ID=                 # Existing iMessage conversation ID (iMessage;+;...)
FAIRROOM_LOCAL_GROUP_ID=group-elm-trio  # Sample group ID for the local demo bridge
FAIRROOM_LOCAL_MEMBER_MAP={}            # Maps sender handles to sample member IDs

# --- Optional Chalk gateway (intent classification only) ---
AI_PROVIDER=openai                      # openai | chalk
CHALK_ROUTER_API_KEY=                   # Chalk gateway API key
CHALK_ENV_ID=                           # Chalk environment ID
CHALK_MODEL=                            # Chalk model name

# --- Factory Droid SDK (independent listing reviews) ---
FACTORY_ENABLED=false                   # Set true only with live Factory credentials
FACTORY_API_KEY=                        # Factory API key
FACTORY_DROID_PATH=                     # Path to Droid CLI/installation
FACTORY_MODEL=                          # Factory model identifier

# --- Data directory ---
FAIRROOM_DATA_DIR=data                  # Directory for the sql.js database and fixtures

# --- Local phone household (real iMessage demo with actual phone numbers) ---
FAIRROOM_LOCAL_REAL_HOUSEHOLD=false     # Opt-in: real surveys and catalog through local chat
FAIRROOM_GROUP_TEST_MEMBER=             # Brother's phone number for phone household setup
FAIRROOM_BROTHER_IMESSAGE_EMAIL=        # Brother's verified iMessage email (mapped to same roommate)
FAIRROOM_SISTER_PHONE=                  # Optional third participant's phone number
